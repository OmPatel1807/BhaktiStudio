# Bhakti Studio Production Environment Configuration Template

# Server Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-domain.com

# PostgreSQL Production Database URL
DATABASE_URL="postgresql://db_user:db_password@your-production-db-host:5432/bhakti_studio_prod?schema=public"

# Authentication Secrets
JWT_SECRET="YOUR_STRONG_PRODUCTION_JWT_SECRET_KEY"
JWT_EXPIRES_IN=7d

# Google OAuth Production Credentials
GOOGLE_CLIENT_ID="YOUR_PRODUCTION_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET"

# Payment Gateway (Razorpay Live Keys)
PAYMENT_GATEWAY_KEY="rzp_live_YOUR_PRODUCTION_KEY"
PAYMENT_GATEWAY_SECRET="YOUR_PRODUCTION_RAZORPAY_SECRET"

# Cloud Storage (AWS S3 / GCP Bucket)
CLOUD_STORAGE_BUCKET=bhakti-studio-production-assets
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_KEY=YOUR_AWS_ACCESS_KEY
CLOUD_STORAGE_SECRET=YOUR_AWS_SECRET_KEY

# WhatsApp Business Meta Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_API_TOKEN=YOUR_META_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

# Email Nodemailer SMTP Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
