# Bhakti Studio Environment Variables

# Application Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bhakti_studio?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_bhakti_studio_2026_change_in_production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Payment Gateway Configuration (Razorpay / Stripe)
PAYMENT_GATEWAY_KEY=rzp_test_your_key_here
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret_here

# Cloud Storage Configuration (S3 / Cloudinary / GCP)
CLOUD_STORAGE_BUCKET=bhakti-studio-assets
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_KEY=your_cloud_storage_access_key
CLOUD_STORAGE_SECRET=your_cloud_storage_secret_key

# WhatsApp Business API Configuration
WHATSAPP_API_TOKEN=your_whatsapp_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
